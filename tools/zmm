#!/bin/bash
# Windows-side wrapper: runs the WSL tools from the project root.
#   tools/zmm asm   <seg> <fn>              show the original assembly
#   tools/zmm m2c   <seg> <fn>              first-draft C from m2c (often wrong: always verify)
#   tools/zmm match <seg> <fn> <file.c>     compile with IDO 7.1 and compare with the ROM bytes
#   tools/zmm diff  <seg> <fn> <file.c>     show original vs our disassembly side by side
set -e
cmd=$1; seg=$2; fn=$3; file=$4
[ -L ~/zmm ] || true
MSYS_NO_PATHCONV=1 wsl.exe -d Ubuntu -- bash -c "
cd '/mnt/c/Users/minec/Projets/ZMM N64 Europe C' && . ~/zmm-venv/bin/activate
case $cmd in
  asm)   awk '/^glabel $fn\$/{p=1} p{print} /^endlabel $fn\$/{exit}' asm/$seg/text.s ;;
  m2c)   python3 tools/vendor/m2c/m2c.py -t mips-ido-c -f $fn asm/$seg/text.s ;;
  match) python3 tools/match.py $seg $fn '$file' ;;
  diff)  python3 tools/disasm_diff.py $seg $fn '$file' ;;
esac" 2>&1 | tr -d '\0'
